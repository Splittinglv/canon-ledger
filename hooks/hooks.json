{
  "version": 1,
  "description": "Cursor runtime guardrails: inject plugin/workspace paths on session start and block direct writes to Story System/read-model files.",
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 -X utf8 \"${CURSOR_PLUGIN_ROOT}/hooks/session_start.py\"",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "python3 -X utf8 \"${CURSOR_PLUGIN_ROOT}/hooks/guard_runtime_write.py\"",
        "matcher": "Write|StrReplace|Edit|Delete",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 -X utf8 \"${CURSOR_PLUGIN_ROOT}/hooks/guard_runtime_write.py\"",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
