{
  "schema_version": "canon-ledger-behavior-evals/v2",
  "suite": "fast",
  "cases": [
    {
      "id": "skill_frontmatter",
      "type": "skill_frontmatter",
      "description": "每个 Skill 都包含可路由元数据。"
    },
    {
      "id": "skill_init_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-init",
      "description": "初始化技能只能对 clean target 建立经过确认的 Canon v3 起点。",
      "required": ["clean target", "author_axiom_snapshot", "genesis_admissions", "bootstrap_mode=canon_v3", "/canon-ledger-learn"]
    },
    {
      "id": "skill_plan_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-plan",
      "description": "规划技能必须区分软计划、硬设定草案与文风。",
      "required": ["author_axiom_proposals", "不得直接覆盖活动设定", "author-axiom-prepare", "author-axiom-decide", "author-axiom-finalize", "删除旧事实型 `update-state`"]
    },
    {
      "id": "skill_write_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-write",
      "description": "写章技能必须遵守有版本的事实事务和写作闸门。",
      "required": ["expected_stage_digest", "finalize_token", "data-agent phase=extract", "projection_fresh == true"]
    },
    {
      "id": "skill_review_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-review",
      "description": "审查技能只检查长期事实且区分草稿审查与历史审计。",
      "required": ["Historical audit", "exact candidate draft", "不创建或替换 STAGING", "删除旧 `issues/manual_checks/blocking`"]
    },
    {
      "id": "skill_confirm_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-confirm",
      "description": "确认技能必须精确绑定作者看到的证据与事务版本。",
      "required": ["canon-v3/decision-request/v2", "target_digest", "material_digest", "canon-v3/finalize-request/v2", "canon-v3/author-axiom-decision-request/v2", "canon-v3/legacy-recertification-publish-request/v1", "repair-cutover --apply"]
    },
    {
      "id": "skill_query_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-query",
      "description": "查询技能必须区分活动正史、暂存提议与旧数据。",
      "required": ["active_canon", "staged_proposal", "legacy_read_only", "不能覆盖 HEAD"]
    },
    {
      "id": "skill_dashboard_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-dashboard",
      "description": "仪表盘技能只能展示绑定当前 HEAD 的只读事实。",
      "required": ["/api/canon-v3/workflow", "head_hash, generation", "不能读取 legacy `index.db`"]
    },
    {
      "id": "skill_doctor_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-doctor",
      "description": "诊断技能必须先检查权威工作流和迁移状态。",
      "required": ["只读", "stage digest", "legacy prefix/genesis 是否需要 recertification"]
    },
    {
      "id": "skill_learn_contract",
      "type": "skill_contract",
      "skill": "canon-ledger-learn",
      "description": "文风学习只能更新风格数据，不能改变 Canon。",
      "required": ["style-memory add-item", "head_hash/workflow_digest/stage_digest", "必须完全不变"]
    },
    {
      "id": "write_blocks_before_commit",
      "type": "write_blocking_gate",
      "description": "写章必须消费 exact stage/finalize 版本并通过三道 v3 gate。"
    },
    {
      "id": "data_agent_artifact_only",
      "type": "data_agent_boundary",
      "description": "data-agent 只生成 v2 typed proposal，不写正史或队列。"
    },
    {
      "id": "artifact_ownership",
      "type": "artifact_ownership",
      "description": "reviewer 只读，data-agent 只写唯一 proposal。"
    },
    {
      "id": "dashboard_read_only",
      "type": "dashboard_read_only",
      "description": "Dashboard 只提供 GET API。"
    }
  ]
}
